<local:ChordiousWindow
        MinHeight="100"
        CanResize="False"
        SizeToContent="Height"
        Title="{Binding Title}"
        Width="500"
        WindowStartupLocation="CenterScreen"
        x:Class="Chordious.Avalonia.InformationWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:vm="using:Chordious.Core.ViewModel"
        xmlns:local="using:Chordious.Avalonia"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Window.KeyBindings>
        <KeyBinding Command="{Binding Accept, Mode=OneWay}" Gesture="Escape" />
    </Window.KeyBindings>
    <StackPanel>
        <StackPanel Orientation="Horizontal">
            <Image Margin="15"
                   Source="/Resources/information32.png"
                   VerticalAlignment="Top" />
            <Label Focusable="True"
                   Margin="5"
                   Name="MessageLabel"
                   VerticalAlignment="Center"
                   Width="390">
                <Label.Content>
                    <TextBlock Text="{Binding Message}"
                               TextWrapping="Wrap" />
                </Label.Content>
            </Label>
        </StackPanel>
        <StackPanel HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button Command="{Binding Accept}"
                    Content="{x:Static vm:AppViewModel.AcceptLabel}"
                    IsDefault="True"
                    Margin="5"
                    Classes="clean"
                    Width="75" />
        </StackPanel>
    </StackPanel>
</local:ChordiousWindow>
