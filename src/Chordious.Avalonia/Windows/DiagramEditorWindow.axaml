<local:ChordiousWindow Height="600"
        MinHeight="600"
        MinWidth="800"
        Title="{Binding Title}"
        Width="800"
        WindowStartupLocation="CenterScreen"
        x:Class="Chordious.Avalonia.DiagramEditorWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:vm="using:Chordious.Core.ViewModel"
        xmlns:local="using:Chordious.Avalonia"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Window.KeyBindings>
        <KeyBinding Command="{Binding ObservableDiagram.RenderImage}" Gesture="F5" />
        <KeyBinding Command="{Binding Cancel, Mode=OneWay}" Gesture="Escape" />
    </Window.KeyBindings>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Column="0"
                      Grid.Row="0"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <local:GroupBox Header="{x:Static vm:DiagramEditorViewModel.DimensionsGroupLabel}"
                          Margin="5">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Label Content="{Binding ObservableDiagram.TotalWidthLabel}"
                                   Height="25"
                                   Margin="5"
                                   Name="TotalWidthLabel"
                                   Target="{Binding #TotalWidthTextBox}"
                                   ToolTip.Tip="{Binding ObservableDiagram.TotalWidthToolTip}"
                                   Width="120" />
                            <TextBox AutomationProperties.LabeledBy="{Binding #TotalWidthLabel}"
                                     Height="25"
                                     HorizontalContentAlignment="Center"
                                     IsReadOnly="True"
                                     Margin="5"
                                     MaxLines="1"
                                     Name="TotalWidthTextBox"
                                     Text="{Binding ObservableDiagram.TotalWidth, Mode=OneWay}"
                                     ToolTip.Tip="{Binding ObservableDiagram.TotalWidthToolTip}"
                                     VerticalAlignment="Center"
                                     VerticalContentAlignment="Center"
                                     Width="80" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Label Content="{Binding ObservableDiagram.TotalHeightLabel}"
                                   Height="25"
                                   Margin="5"
                                   Name="TotalHeightLabel"
                                   Target="{Binding #TotalHeightTextBox}"
                                   ToolTip.Tip="{Binding ObservableDiagram.TotalHeightToolTip}"
                                   Width="120" />
                            <TextBox AutomationProperties.LabeledBy="{Binding #TotalHeightLabel}"
                                     Height="25"
                                     HorizontalContentAlignment="Center"
                                     IsReadOnly="True"
                                     Margin="5"
                                     MaxLines="1"
                                     Name="TotalHeightTextBox"
                                     Text="{Binding ObservableDiagram.TotalHeight, Mode=OneWay}"
                                     ToolTip.Tip="{Binding ObservableDiagram.TotalHeightToolTip}"
                                     VerticalAlignment="Center"
                                     VerticalContentAlignment="Center"
                                     Width="80" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Label Content="{Binding ObservableDiagram.NumFretsLabel}"
                                   Height="25"
                                   Margin="5"
                                   Name="NumFretsLabel"
                                   Target="{Binding #NumFretsUpDown}"
                                   ToolTip.Tip="{Binding ObservableDiagram.NumFretsToolTip}"
                                   Width="120" />
                            <NumericUpDown Classes="int" AutomationProperties.LabeledBy="{Binding #NumFretsLabel}"
                                                Height="25"
                                                HorizontalContentAlignment="Center"
                                                Margin="5"
                                                Minimum="1"
                                                Name="NumFretsUpDown"
                                                ToolTip.Tip="{Binding ObservableDiagram.NumFretsToolTip}"
                                                Value="{Binding ObservableDiagram.NumFrets}"
                                                VerticalAlignment="Center"
                                                VerticalContentAlignment="Center"
                                                Width="80" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Label Content="{Binding ObservableDiagram.NumStringsLabel}"
                                   Height="25"
                                   Margin="5"
                                   Name="NumStringsLabel"
                                   Target="{Binding #NumStringsUpDown}"
                                   ToolTip.Tip="{Binding ObservableDiagram.NumStringsToolTip}"
                                   Width="120" />
                            <NumericUpDown Classes="int" AutomationProperties.LabeledBy="{Binding #NumStringsLabel}"
                                                Height="25"
                                                HorizontalContentAlignment="Center"
                                                Margin="5"
                                                Minimum="2"
                                                Name="NumStringsUpDown"
                                                ToolTip.Tip="{Binding ObservableDiagram.NumStringsToolTip}"
                                                Value="{Binding ObservableDiagram.NumStrings}"
                                                VerticalAlignment="Center"
                                                VerticalContentAlignment="Center"
                                                Width="80" />
                        </StackPanel>
                    </StackPanel>
                </local:GroupBox>
                <local:GroupBox Header="{x:Static vm:DiagramEditorViewModel.DiagramLayoutGroupLabel}"
                          Margin="5">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <CheckBox Content="{Binding Style.SelectedOrientationLabel}"
                                      Height="25"
                                      IsChecked="{Binding Style.OrientationIsLocal}"
                                      Margin="5"
                                      Name="OrientationIsLocalCheckBox"
                                      ToolTip.Tip="{Binding Style.SelectedOrientationToolTip}"
                                      VerticalAlignment="Center"
                                      VerticalContentAlignment="Center"
                                      Width="120" />
                            <ComboBox AutomationProperties.LabeledBy="{Binding #OrientationIsLocalCheckBox}"
                                      Height="25"
                                      IsEnabled="{Binding Style.OrientationIsLocal}"
                                      ItemsSource="{Binding Style.Orientations}"
                                      Margin="5"
                                      SelectedIndex="{Binding Style.SelectedOrientationIndex}"
                                      Classes="clean"
                                      ToolTip.Tip="{Binding Style.SelectedOrientationToolTip}"
                                      VerticalAlignment="Center"
                                      VerticalContentAlignment="Center"
                                      Width="80" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <CheckBox Content="{Binding Style.SelectedLabelLayoutModelLabel}"
                                      Height="25"
                                      IsChecked="{Binding Style.LabelLayoutModelIsLocal}"
                                      Margin="5"
                                      Name="LabelLayoutModelIsLocalCheckBox"
                                      ToolTip.Tip="{Binding Style.SelectedLabelLayoutModelToolTip}"
                                      VerticalAlignment="Center"
                                      VerticalContentAlignment="Center"
                                      Width="120" />
                            <ComboBox AutomationProperties.LabeledBy="{Binding #LabelLayoutModelIsLocalCheckBox}"
                                      Height="25"
                                      IsEnabled="{Binding Style.LabelLayoutModelIsLocal}"
                                      ItemsSource="{Binding Style.LabelLayoutModels}"
                                      Margin="5"
                                      SelectedIndex="{Binding Style.SelectedLabelLayoutModelIndex}"
                                      Classes="clean"
                                      ToolTip.Tip="{Binding Style.SelectedLabelLayoutModelToolTip}"
                                      VerticalAlignment="Center"
                                      VerticalContentAlignment="Center"
                                      Width="80" />
                        </StackPanel>
                    </StackPanel>
                </local:GroupBox>
                <local:GroupBox Header="{x:Static vm:DiagramEditorViewModel.DiagramBackgroundGroupLabel}"
                          Margin="5">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <CheckBox Content="{Binding Style.DiagramColorLabel}"
                                      Height="25"
                                      IsChecked="{Binding Style.DiagramColorIsLocal}"
                                      Margin="5"
                                      Name="DiagramColorIsLocalCheckBox"
                                      ToolTip.Tip="{Binding Style.DiagramColorToolTip}"
                                      VerticalAlignment="Center"
                                      VerticalContentAlignment="Center"
                                      Width="120" />
                            <ColorPicker AutomationProperties.LabeledBy="{Binding #DiagramColorIsLocalCheckBox}"
                                              Height="25"
                                              IsEnabled="{Binding Style.DiagramColorIsLocal}"
                                              Margin="5"
                                              Color="{Binding Style.DiagramColor, Converter={StaticResource StringToColorConverter}}"
                                              ToolTip.Tip="{Binding Style.DiagramColorToolTip}"
                                              VerticalAlignment="Center"
                                              Width="80" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <CheckBox Content="{Binding Style.DiagramOpacityLabel}"
                                      Height="25"
                                      IsChecked="{Binding Style.DiagramOpacityIsLocal}"
                                      Margin="5"
                                      Name="DiagramOpacityIsLocalCheckBox"
                                      ToolTip.Tip="{Binding Style.DiagramOpacityToolTip}"
                                      VerticalAlignment="Center"
                                      VerticalContentAlignment="Center"
                                      Width="120" />
                            <NumericUpDown AutomationProperties.LabeledBy="{Binding #DiagramOpacityIsLocalCheckBox}"
                                               Height="25"
                                               HorizontalContentAlignment="Center"
                                               IsEnabled="{Binding Style.DiagramOpacityIsLocal}"
                                               Margin="5"
                                               Classes="percent boundpercent"
                                               ToolTip.Tip="{Binding Style.DiagramOpacityToolTip}"
                                               Value="{Binding Style.DiagramOpacity}"
                                               VerticalAlignment="Center"
                                               VerticalContentAlignment="Center"
                                               Width="80" />
                        </StackPanel>
                    </StackPanel>
                </local:GroupBox>
                <local:GroupBox Header="{x:Static vm:DiagramEditorViewModel.DiagramBorderGroupLabel}"
                          Margin="5">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <CheckBox Content="{Binding Style.DiagramBorderColorLabel}"
                                      Height="25"
                                      IsChecked="{Binding Style.DiagramBorderColorIsLocal}"
                                      Margin="5"
                                      Name="DiagramBorderColorIsLocalCheckBox"
                                      ToolTip.Tip="{Binding Style.DiagramBorderColorToolTip}"
                                      VerticalAlignment="Center"
                                      VerticalContentAlignment="Center"
                                      Width="120" />
                            <ColorPicker AutomationProperties.LabeledBy="{Binding #DiagramBorderColorIsLocalCheckBox}"
                                              Height="25"
                                              IsEnabled="{Binding Style.DiagramBorderColorIsLocal}"
                                              Margin="5"
                                              Color="{Binding Style.DiagramBorderColor, Converter={StaticResource StringToColorConverter}}"
                                              ToolTip.Tip="{Binding Style.DiagramBorderColorToolTip}"
                                              VerticalAlignment="Center"
                                              Width="80" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <CheckBox Content="{Binding Style.DiagramBorderThicknessLabel}"
                                      Height="25"
                                      IsChecked="{Binding Style.DiagramBorderThicknessIsLocal}"
                                      Margin="5"
                                      Name="DiagramBorderThicknessIsLocalCheckBox"
                                      ToolTip.Tip="{Binding Style.DiagramBorderThicknessToolTip}"
                                      VerticalAlignment="Center"
                                      VerticalContentAlignment="Center"
                                      Width="120" />
                            <NumericUpDown AutomationProperties.LabeledBy="{Binding #DiagramBorderThicknessIsLocalCheckBox}"
                                               Height="25"
                                               HorizontalContentAlignment="Center"
                                               IsEnabled="{Binding Style.DiagramBorderThicknessIsLocal}"
                                               Margin="5"
                                               Classes="pixel"
                                               ToolTip.Tip="{Binding Style.DiagramBorderThicknessToolTip}"
                                               Value="{Binding Style.DiagramBorderThickness}"
                                               VerticalAlignment="Center"
                                               VerticalContentAlignment="Center"
                                               Width="80" />
                        </StackPanel>
                    </StackPanel>
                </local:GroupBox>
                <local:GroupBox Header="{x:Static vm:DiagramEditorViewModel.GridSpacingGroupLabel}"
                          Margin="5">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <CheckBox Content="{Binding Style.GridFretSpacingLabel}"
                                      Height="25"
                                      IsChecked="{Binding Style.GridFretSpacingIsLocal}"
                                      Margin="5"
                                      Name="GridFretSpacingIsLocalCheckBox"
                                      ToolTip.Tip="{Binding Style.GridFretSpacingToolTip}"
                                      VerticalAlignment="Center"
                                      VerticalContentAlignment="Center"
                                      Width="120" />
                            <NumericUpDown AutomationProperties.LabeledBy="{Binding #GridFretSpacingIsLocalCheckBox}"
                                               Height="25"
                                               HorizontalContentAlignment="Center"
                                               IsEnabled="{Binding Style.GridFretSpacingIsLocal}"
                                               Margin="5"
                                               Classes="pixel"
                                               ToolTip.Tip="{Binding Style.GridFretSpacingToolTip}"
                                               Value="{Binding Style.GridFretSpacing}"
                                               VerticalAlignment="Center"
                                               VerticalContentAlignment="Center"
                                               Width="80" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <CheckBox Content="{Binding Style.GridStringSpacingLabel}"
                                      Height="25"
                                      IsChecked="{Binding Style.GridStringSpacingIsLocal}"
                                      Margin="5"
                                      Name="GridStringSpacingIsLocalCheckBox"
                                      ToolTip.Tip="{Binding Style.GridStringSpacingToolTip}"
                                      VerticalAlignment="Center"
                                      VerticalContentAlignment="Center"
                                      Width="120" />
                            <NumericUpDown AutomationProperties.LabeledBy="{Binding #GridStringSpacingIsLocalCheckBox}"
                                               Height="25"
                                               HorizontalContentAlignment="Center"
                                               IsEnabled="{Binding Style.GridStringSpacingIsLocal}"
                                               Margin="5"
                                               Classes="pixel"
                                               ToolTip.Tip="{Binding Style.GridStringSpacingToolTip}"
                                               Value="{Binding Style.GridStringSpacing}"
                                               VerticalAlignment="Center"
                                               VerticalContentAlignment="Center"
                                               Width="80" />
                        </StackPanel>
                    </StackPanel>
                </local:GroupBox>
                <local:GroupBox Header="{x:Static vm:DiagramEditorViewModel.GridMarginGroupLabel}"
                          Margin="5">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <CheckBox Content="{Binding Style.GridMarginLabel}"
                                      Height="25"
                                      IsChecked="{Binding Style.GridMarginIsLocal}"
                                      Margin="5"
                                      Name="GridMarginIsLocalCheckBox"
                                      ToolTip.Tip="{Binding Style.GridMarginToolTip}"
                                      VerticalAlignment="Center"
                                      VerticalContentAlignment="Center"
                                      Width="120" />
                            <NumericUpDown AutomationProperties.LabeledBy="{Binding #GridMarginIsLocalCheckBox}"
                                               Height="25"
                                               HorizontalContentAlignment="Center"
                                               IsEnabled="{Binding Style.GridMarginIsLocal}"
                                               Margin="5"
                                               Classes="pixel"
                                               ToolTip.Tip="{Binding Style.GridMarginToolTip}"
                                               Value="{Binding Style.GridMargin}"
                                               VerticalAlignment="Center"
                                               VerticalContentAlignment="Center"
                                               Width="80" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <CheckBox Content="{Binding Style.GridMarginLeftLabel}"
                                      Height="25"
                                      IsChecked="{Binding Style.GridMarginLeftIsLocal}"
                                      Margin="5"
                                      Name="GridMarginLeftIsLocalCheckBox"
                                      ToolTip.Tip="{Binding Style.GridMarginLeftToolTip}"
                                      VerticalAlignment="Center"
                                      VerticalContentAlignment="Center"
                                      Width="120" />
                            <NumericUpDown AutomationProperties.LabeledBy="{Binding #GridMarginLeftIsLocalCheckBox}"
                                               Height="25"
                                               HorizontalContentAlignment="Center"
                                               IsEnabled="{Binding Style.GridMarginLeftIsLocal}"
                                               Margin="5"
                                               Classes="pixel"
                                               ToolTip.Tip="{Binding Style.GridMarginLeftToolTip}"
                                               Value="{Binding Style.GridMarginLeft}"
                                               VerticalAlignment="Center"
                                               VerticalContentAlignment="Center"
                                               Width="80" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <CheckBox Content="{Binding Style.GridMarginRightLabel}"
                                      Height="25"
                                      IsChecked="{Binding Style.GridMarginRightIsLocal}"
                                      Margin="5"
                                      Name="GridMarginRightIsLocalCheckBox"
                                      ToolTip.Tip="{Binding Style.GridMarginRightToolTip}"
                                      VerticalAlignment="Center"
                                      VerticalContentAlignment="Center"
                                      Width="120" />
                            <NumericUpDown AutomationProperties.LabeledBy="{Binding #GridMarginRightIsLocalCheckBox}"
                                               Height="25"
                                               HorizontalContentAlignment="Center"
                                               IsEnabled="{Binding Style.GridMarginRightIsLocal}"
                                               Margin="5"
                                               Classes="pixel"
                                               ToolTip.Tip="{Binding Style.GridMarginRightToolTip}"
                                               Value="{Binding Style.GridMarginRight}"
                                               VerticalAlignment="Center"
                                               VerticalContentAlignment="Center"
                                               Width="80" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <CheckBox Content="{Binding Style.GridMarginTopLabel}"
                                      Height="25"
                                      IsChecked="{Binding Style.GridMarginTopIsLocal}"
                                      Margin="5"
                                      Name="GridMarginTopIsLocalCheckBox"
                                      ToolTip.Tip="{Binding Style.GridMarginTopToolTip}"
                                      VerticalAlignment="Center"
                                      VerticalContentAlignment="Center"
                                      Width="120" />
                            <NumericUpDown AutomationProperties.LabeledBy="{Binding #GridMarginTopIsLocalCheckBox}"
                                               Height="25"
                                               HorizontalContentAlignment="Center"
                                               IsEnabled="{Binding Style.GridMarginTopIsLocal}"
                                               Margin="5"
                                               Classes="pixel"
                                               ToolTip.Tip="{Binding Style.GridMarginTopToolTip}"
                                               Value="{Binding Style.GridMarginTop}"
                                               VerticalAlignment="Center"
                                               VerticalContentAlignment="Center"
                                               Width="80" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <CheckBox Content="{Binding Style.GridMarginBottomLabel}"
                                      Height="25"
                                      IsChecked="{Binding Style.GridMarginBottomIsLocal}"
                                      Margin="5"
                                      Name="GridMarginBottomIsLocalCheckBox"
                                      ToolTip.Tip="{Binding Style.GridMarginBottomToolTip}"
                                      VerticalAlignment="Center"
                                      VerticalContentAlignment="Center"
                                      Width="120" />
                            <NumericUpDown AutomationProperties.LabeledBy="{Binding #GridMarginBottomIsLocalCheckBox}"
                                               Height="25"
                                               HorizontalContentAlignment="Center"
                                               IsEnabled="{Binding Style.GridMarginBottomIsLocal}"
                                               Margin="5"
                                               Classes="pixel"
                                               ToolTip.Tip="{Binding Style.GridMarginBottomToolTip}"
                                               Value="{Binding Style.GridMarginBottom}"
                                               VerticalAlignment="Center"
                                               VerticalContentAlignment="Center"
                                               Width="80" />
                        </StackPanel>
                    </StackPanel>
                </local:GroupBox>
                <local:GroupBox Header="{x:Static vm:DiagramEditorViewModel.GridBackgroundGroupLabel}"
                          Margin="5">
                    <StackPanel>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <CheckBox Content="{Binding Style.GridColorLabel}"
                                          Height="25"
                                          IsChecked="{Binding Style.GridColorIsLocal}"
                                          Margin="5"
                                          Name="GridColorIsLocalCheckBox"
                                          ToolTip.Tip="{Binding Style.GridColorToolTip}"
                                          VerticalAlignment="Center"
                                          VerticalContentAlignment="Center"
                                          Width="120" />
                                <ColorPicker AutomationProperties.LabeledBy="{Binding #GridColorIsLocalCheckBox}"
                                                  Height="25"
                                                  IsEnabled="{Binding Style.GridColorIsLocal}"
                                                  Margin="5"
                                                  Color="{Binding Style.GridColor, Converter={StaticResource StringToColorConverter}}"
                                                  ToolTip.Tip="{Binding Style.GridColorToolTip}"
                                                  VerticalAlignment="Center"
                                                  Width="80" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <CheckBox Content="{Binding Style.GridOpacityLabel}"
                                          Height="25"
                                          IsChecked="{Binding Style.GridOpacityIsLocal}"
                                          Margin="5"
                                          Name="GridOpacityIsLocalCheckBox"
                                          ToolTip.Tip="{Binding Style.GridOpacityToolTip}"
                                          VerticalAlignment="Center"
                                          VerticalContentAlignment="Center"
                                          Width="120" />
                                <NumericUpDown AutomationProperties.LabeledBy="{Binding #GridOpacityIsLocalCheckBox}"
                                                   Height="25"
                                                   HorizontalContentAlignment="Center"
                                                   IsEnabled="{Binding Style.GridOpacityIsLocal}"
                                                   Margin="5"
                                                   Classes="percent boundpercent"
                                                   ToolTip.Tip="{Binding Style.GridOpacityToolTip}"
                                                   Value="{Binding Style.GridOpacity}"
                                                   VerticalAlignment="Center"
                                                   VerticalContentAlignment="Center"
                                                   Width="80" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </local:GroupBox>
                <local:GroupBox Header="{x:Static vm:DiagramEditorViewModel.GridLineGroupLabel}"
                          Margin="5">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <CheckBox Content="{Binding Style.GridLineColorLabel}"
                                      Height="25"
                                      IsChecked="{Binding Style.GridLineColorIsLocal}"
                                      Margin="5"
                                      Name="GridLineColorIsLocalCheckBox"
                                      ToolTip.Tip="{Binding Style.GridLineColorToolTip}"
                                      VerticalAlignment="Center"
                                      VerticalContentAlignment="Center"
                                      Width="120" />
                            <ColorPicker AutomationProperties.LabeledBy="{Binding #GridLineColorIsLocalCheckBox}"
                                              Height="25"
                                              IsEnabled="{Binding Style.GridLineColorIsLocal}"
                                              Margin="5"
                                              Color="{Binding Style.GridLineColor, Converter={StaticResource StringToColorConverter}}"
                                              ToolTip.Tip="{Binding Style.GridLineColorToolTip}"
                                              VerticalAlignment="Center"
                                              Width="80" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <CheckBox Content="{Binding Style.GridLineThicknessLabel}"
                                      Height="25"
                                      IsChecked="{Binding Style.GridLineThicknessIsLocal}"
                                      Margin="5"
                                      Name="GridLineThicknessIsLocalCheckBox"
                                      ToolTip.Tip="{Binding Style.GridLineThicknessToolTip}"
                                      VerticalAlignment="Center"
                                      VerticalContentAlignment="Center"
                                      Width="120" />
                            <NumericUpDown AutomationProperties.LabeledBy="{Binding #GridLineThicknessIsLocalCheckBox}"
                                               Height="25"
                                               HorizontalContentAlignment="Center"
                                               IsEnabled="{Binding Style.GridLineThicknessIsLocal}"
                                               Margin="5"
                                               Classes="pixel"
                                               ToolTip.Tip="{Binding Style.GridLineThicknessToolTip}"
                                               Value="{Binding Style.GridLineThickness}"
                                               VerticalAlignment="Center"
                                               VerticalContentAlignment="Center"
                                               Width="80" />
                        </StackPanel>
                    </StackPanel>
                </local:GroupBox>
                <local:GroupBox Header="{x:Static vm:DiagramEditorViewModel.GridNutGroupLabel}"
                          Margin="5">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <CheckBox Content="{Binding Style.GridNutVisibleLabel}"
                                      Height="25"
                                      IsChecked="{Binding Style.GridNutVisibleIsLocal}"
                                      Margin="5"
                                      Name="GridNutVisibleIsLocalCheckBox"
                                      ToolTip.Tip="{Binding Style.GridNutVisibleToolTip}"
                                      VerticalAlignment="Center"
                                      VerticalContentAlignment="Center"
                                      Width="120" />
                            <CheckBox AutomationProperties.LabeledBy="{Binding #GridNutVisibleIsLocalCheckBox}"
                                      Height="25"
                                      IsChecked="{Binding Style.GridNutVisible}"
                                      IsEnabled="{Binding Style.GridNutVisibleIsLocal}"
                                      Margin="5"
                                      ToolTip.Tip="{Binding Style.GridNutVisibleToolTip}"
                                      VerticalAlignment="Center"
                                      VerticalContentAlignment="Center"
                                      Width="80" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <CheckBox Content="{Binding Style.GridNutRatioLabel}"
                                      Height="25"
                                      IsChecked="{Binding Style.GridNutRatioIsLocal}"
                                      Margin="5"
                                      Name="GridNutRatioIsLocalCheckBox"
                                      ToolTip.Tip="{Binding Style.GridNutRatioToolTip}"
                                      VerticalAlignment="Center"
                                      VerticalContentAlignment="Center"
                                      Width="120" />
                            <NumericUpDown AutomationProperties.LabeledBy="{Binding #GridNutRatioIsLocalCheckBox}"
                                               Height="25"
                                               HorizontalContentAlignment="Center"
                                               IsEnabled="{Binding Style.GridNutRatioIsLocal}"
                                               Margin="5"
                                               Classes="percent"
                                               ToolTip.Tip="{Binding Style.GridNutRatioToolTip}"
                                               Value="{Binding Style.GridNutRatio}"
                                               VerticalAlignment="Center"
                                               VerticalContentAlignment="Center"
                                               Width="80" />
                        </StackPanel>
                    </StackPanel>
                </local:GroupBox>
            </StackPanel>
        </ScrollViewer>
        <ScrollViewer Grid.Column="1"
                      Grid.Row="0"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto">
            <Image
                   Height="{Binding ObservableDiagram.TotalHeight}"
                   Margin="5"
                   Name="DiagramImage"
                   Source="{Binding ObservableDiagram.ImageObject}"
                   Width="{Binding ObservableDiagram.TotalWidth}" local:Gestures.DoubleTapCommand="{Binding DataContext.ObservableDiagram.EditElement, RelativeSource={RelativeSource AncestorType=Window}}">
                <Image.ContextMenu>
                    <ContextMenu Name="ImageContextMenu">
                        <MenuItem Command="{Binding ObservableDiagram.SendImageToClipboard}"
                                  Header="{Binding ObservableDiagram.SendImageToClipboardLabel}"
                                  ToolTip.Tip="{Binding ObservableDiagram.SendImageToClipboardToolTip}">
                            <MenuItem.Icon>
                                <Image Source="/Resources/copy16.png" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Command="{Binding ObservableDiagram.SendScaledImageToClipboard}"
                                  Header="{Binding ObservableDiagram.SendScaledImageToClipboardLabel}"
                                  ToolTip.Tip="{Binding ObservableDiagram.SendScaledImageToClipboardToolTip}">
                            <MenuItem.Icon>
                                <Image Source="/Resources/copy16.png" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Command="{Binding ObservableDiagram.SendTextToClipboard}"
                                  Header="{Binding ObservableDiagram.SendTextToClipboardLabel}"
                                  ToolTip.Tip="{Binding ObservableDiagram.SendTextToClipboardToolTip}">
                            <MenuItem.Icon>
                                <Image Source="/Resources/copy16.png" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator IsVisible="{Binding ObservableDiagram.ValidCommandsAtCursor}" />
                        <MenuItem Command="{Binding ObservableDiagram.AddMark}"
                                  Header="{Binding ObservableDiagram.AddMarkLabel}"
                                  ToolTip.Tip="{Binding ObservableDiagram.AddMarkToolTip}"
                                  IsVisible="{Binding ObservableDiagram.CanAddMark}">
                            <MenuItem.Icon>
                                <Image Source="/Resources/add16.png" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Command="{Binding ObservableDiagram.EditMark}"
                                  Header="{Binding ObservableDiagram.EditMarkLabel}"
                                  ToolTip.Tip="{Binding ObservableDiagram.EditMarkToolTip}"
                                  IsVisible="{Binding ObservableDiagram.CanEditMark}">
                            <MenuItem.Icon>
                                <Image Source="/Resources/edit16.png" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Command="{Binding ObservableDiagram.RemoveMark}"
                                  Header="{Binding ObservableDiagram.RemoveMarkLabel}"
                                  ToolTip.Tip="{Binding ObservableDiagram.RemoveMarkToolTip}"
                                  IsVisible="{Binding ObservableDiagram.CanRemoveMark}">
                            <MenuItem.Icon>
                                <Image Source="/Resources/remove16.png" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Command="{Binding ObservableDiagram.AddFretLabel}"
                                  Header="{Binding ObservableDiagram.AddFretLabelLabel}"
                                  ToolTip.Tip="{Binding ObservableDiagram.AddFretLabelToolTip}"
                                  IsVisible="{Binding ObservableDiagram.CanAddFretLabel}">
                            <MenuItem.Icon>
                                <Image Source="/Resources/add16.png" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Command="{Binding ObservableDiagram.EditFretLabel}"
                                  Header="{Binding ObservableDiagram.EditFretLabelLabel}"
                                  ToolTip.Tip="{Binding ObservableDiagram.EditFretLabelToolTip}"
                                  IsVisible="{Binding ObservableDiagram.CanEditFretLabel}">
                            <MenuItem.Icon>
                                <Image Source="/Resources/edit16.png" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Command="{Binding ObservableDiagram.RemoveFretLabel}"
                                  Header="{Binding ObservableDiagram.RemoveFretLabelLabel}"
                                  ToolTip.Tip="{Binding ObservableDiagram.RemoveFretLabelToolTip}"
                                  IsVisible="{Binding ObservableDiagram.CanRemoveFretLabel}">
                            <MenuItem.Icon>
                                <Image Source="/Resources/remove16.png" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Command="{Binding ObservableDiagram.AddBarre}"
                                  Header="{Binding ObservableDiagram.AddBarreLabel}"
                                  ToolTip.Tip="{Binding ObservableDiagram.AddBarreToolTip}"
                                  IsVisible="{Binding ObservableDiagram.CanAddBarre}">
                            <MenuItem.Icon>
                                <Image Source="/Resources/add16.png" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Command="{Binding ObservableDiagram.EditBarre}"
                                  Header="{Binding ObservableDiagram.EditBarreLabel}"
                                  ToolTip.Tip="{Binding ObservableDiagram.EditBarreToolTip}"
                                  IsVisible="{Binding ObservableDiagram.CanEditBarre}">
                            <MenuItem.Icon>
                                <Image Source="/Resources/edit16.png" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Command="{Binding ObservableDiagram.RemoveBarre}"
                                  Header="{Binding ObservableDiagram.RemoveBarreLabel}"
                                  ToolTip.Tip="{Binding ObservableDiagram.RemoveBarreToolTip}"
                                  IsVisible="{Binding ObservableDiagram.CanRemoveBarre}">
                            <MenuItem.Icon>
                                <Image Source="/Resources/remove16.png" />
                            </MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </Image.ContextMenu>
            </Image>
        </ScrollViewer>
