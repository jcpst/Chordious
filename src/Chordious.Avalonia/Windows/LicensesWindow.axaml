<local:ChordiousWindow
        MinHeight="100"
        CanResize="False"
        SizeToContent="Height"
        Title="{Binding Title}"
        Width="500"
        WindowStartupLocation="CenterScreen"
        x:Class="Chordious.Avalonia.LicensesWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:vm="using:Chordious.Core.ViewModel"
        xmlns:local="using:Chordious.Avalonia"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Window.KeyBindings>
        <KeyBinding Command="{Binding Accept, Mode=OneWay}" Gesture="Escape" />
    </Window.KeyBindings>
    <StackPanel>
        <TabControl Height="300"
                    ItemsSource="{Binding Licenses}"
                    Margin="5"
                    Name="LicensesTab">
            <TabControl.ItemTemplate>
                <DataTemplate>
                    <Label Content="{Binding Header, Mode=OneWay}" />
                </DataTemplate>
            </TabControl.ItemTemplate>
            <TabControl.ContentTemplate>
                <DataTemplate>
                    <TextBox
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             IsReadOnly="True"
                             Text="{Binding Body, Mode=OneWay}"
                             TextWrapping="Wrap"
                             ScrollViewer.VerticalScrollBarVisibility="Auto" />
                </DataTemplate>
            </TabControl.ContentTemplate>
        </TabControl>
        <StackPanel HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button Command="{Binding Accept}"
                    Content="{x:Static vm:AppViewModel.AcceptLabel}"
                    IsDefault="True"
                    Margin="5"
                    Classes="clean"
                    Width="75" />
        </StackPanel>
    </StackPanel>
</local:ChordiousWindow>
