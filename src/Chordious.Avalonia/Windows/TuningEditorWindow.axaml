<local:ChordiousWindow
        MinWidth="400"
        CanResize="False"
        SizeToContent="WidthAndHeight"
        Title="{Binding Title}"
        WindowStartupLocation="CenterScreen"
        x:Class="Chordious.Avalonia.TuningEditorWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:vm="using:Chordious.Core.ViewModel"
        xmlns:local="using:Chordious.Avalonia"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Window.KeyBindings>
        <KeyBinding Command="{Binding Cancel, Mode=OneWay}" Gesture="Escape" />
    </Window.KeyBindings>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Label Content="{Binding NameLabel}"
               Grid.Column="0"
               Grid.Row="0"
               Margin="5"
               Name="NameLabel"
               Target="{Binding #NameTextBox}"
               ToolTip.Tip="{Binding NameToolTip}" />
        <TextBox AutomationProperties.LabeledBy="{Binding #NameLabel}"
                 Grid.Column="1"
                 Grid.Row="0"
                 IsReadOnly="{Binding ReadOnly}"
                 Margin="5"
                 MaxLines="1"
                 Name="NameTextBox"
                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                 ToolTip.Tip="{Binding NameToolTip}" />
        <Label Content="{Binding RootNotesLabel}"
               Grid.Column="0"
               Grid.Row="1"
               Margin="5"
               Name="RootNotesLabel"
               Target="{Binding #RootNotesItemsControl}"
               ToolTip.Tip="{Binding RootNotesToolTip}" />
        <ItemsControl AutomationProperties.LabeledBy="{Binding #RootNotesLabel}"
                      Grid.Column="1"
                      Grid.Row="1"
                      ItemsSource="{Binding RootNotes}"
                      Margin="5"
                      Name="RootNotesItemsControl"
                      ToolTip.Tip="{Binding RootNotesToolTip}"
                      VerticalAlignment="Center">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,0,5,0"
                                Orientation="Horizontal">
                        <ComboBox AutomationProperties.Name="{Binding SelectedNoteLabel}"
                                  IsEnabled="{Binding DataContext.ReadOnly, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBoolConverter}}"
                                  ItemsSource="{Binding Notes}"
                                  SelectedIndex="{Binding SelectedNoteIndex}"
                                  Classes="clean"
                                  ToolTip.Tip="{Binding SelectedNoteToolTip}" />
                        <NumericUpDown Classes="int" AutomationProperties.Name="{Binding OctaveLabel}"
                                            IsReadOnly="{Binding DataContext.ReadOnly, RelativeSource={RelativeSource AncestorType=Window}}"
                                            Margin="0,0,5,0"
                                            Minimum="0"
                                            ToolTip.Tip="{Binding OctaveToolTip}"
                                            Value="{Binding Octave}" />
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <StackPanel Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Grid.Row="2"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button Command="{Binding Accept}"
                    Content="{x:Static vm:AppViewModel.AcceptLabel}"
                    IsDefault="True"
                    Margin="5"
                    Classes="clean"
                    Width="75" />
            <Button Command="{Binding Cancel}"
                    Content="{x:Static vm:AppViewModel.CancelLabel}"
                    Margin="5"
                    Classes="clean"
                    Width="75" />
        </StackPanel>
    </Grid>
</local:ChordiousWindow>
